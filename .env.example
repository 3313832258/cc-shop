# CC-Shop 全栈部署环境变量
# 复制此文件为 .env 并修改为你的实际值
# 用法: docker compose up -d

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_APP_USER=ccshop
MYSQL_APP_PASSWORD=your_password

# ==================== Redis ====================
REDIS_PASSWORD=your_password

# ==================== RabbitMQ ====================
RABBITMQ_USER=ccshop
RABBITMQ_PASSWORD=your_password

# ==================== Nacos ====================
# Nacos 使用 MySQL 存储配置，需要单独的数据库密码
NACOS_DB_PASSWORD=your_password

# ==================== JWT ====================
# JWT 签名密钥，长度需 >= 256 bit，生产环境务必修改
JWT_SECRET=your_jwt_secret_key_change_in_prod

# ==================== AI 智能客服 ====================
# 通义千问 DashScope API Key（申请地址：https://dashscope.console.aliyun.com/）
DASHSCOPE_API_KEY=sk-xxx

# ==================== 前端 ====================
# API 地址（Docker 内部网络使用服务名）
# NUXT_PUBLIC_API_BASE=http://cc-gateway:8080
