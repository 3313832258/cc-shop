# CC-Shop 环境变量配置模板
# 复制此文件为 .env 并修改为生产环境的值
# 用法: docker compose --env-file .env -f infra.yml up -d

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=Root@2026!
MYSQL_APP_USER=ccshop
MYSQL_APP_PASSWORD=CcShop@2026!
MYSQL_PORT=3307

# ==================== Redis ====================
REDIS_PASSWORD=CcShop@2026!

# ==================== RabbitMQ ====================
RABBITMQ_USER=ccshop
RABBITMQ_PASSWORD=CcShop@2026!

# ==================== Nacos ====================
# Nacos 使用 MySQL 存储配置，需要单独的数据库密码
NACOS_DB_PASSWORD=CcShop@2026!

# ==================== JWT ====================
# JWT 签名密钥，长度需 >= 256 bit，生产环境务必修改
JWT_SECRET=ccshop-secret-key-for-jwt-signing-please-change-in-prod-2026

# ==================== 应用配置 ====================
# Nacos 地址
NACOS_ADDR=127.0.0.1:8848

# Sentinel Dashboard 地址
SENTINEL_DASHBOARD=127.0.0.1:8080